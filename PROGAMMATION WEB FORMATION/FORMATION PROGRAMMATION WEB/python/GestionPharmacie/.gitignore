# ====================================================================
# ENVIRONNEMENTS VIRTUELS (DÉPENDANCES PYTHON)
# ====================================================================
# Bloque le dossier "env" et ses variantes pour ne pas envoyer les Go de données
env/
env.bak/

# ====================================================================
# CACHE PYTHON ET FICHIERS COMPILÉS
# ====================================================================
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ====================================================================
# SPÉCIFIQUE À DJANGO
# ====================================================================
# Base de données locale (à ne jamais envoyer en production)
db.sqlite3
db.sqlite3-journal

# Fichiers médias téléversés par les utilisateurs
/media/

# Fichiers statiques collectés (générés via collectstatic)
/staticfiles/

# Fichiers de configuration des variables d'environnement (Mots de passe, clés secrètes)
.env
.env.[a-zA-Z0-9]*
!*.env.example

# ====================================================================
# ÉDITEURS DE CODE (VS CODE, PYCHARM) ET SYSTÈME
# ====================================================================
.vscode/*
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
